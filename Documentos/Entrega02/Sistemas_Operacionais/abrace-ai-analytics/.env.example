# Intervalo entre coletas (segundos)
COLLECTION_INTERVAL_SECONDS=5

# Diretorios base (sao resolvidos relativos ao diretorio do projeto)
DATA_DIR=./data
MODEL_DIR=./data/models
REPORT_DIR=./reports

# Porta do dashboard Streamlit
DASHBOARD_PORT=8501
DASHBOARD_HOST=0.0.0.0

# Janela exibida pelo dashboard em tempo real (minutos)
DASHBOARD_WINDOW_MIN=60

# Refresh automatico do dashboard (segundos). 0 desativa.
DASHBOARD_REFRESH_SECONDS=10

# Limites para rotulagem de risco (classificacao)
THRESH_NORMAL_CPU=50
THRESH_NORMAL_MEM=60
THRESH_CRITICAL_CPU=80
THRESH_CRITICAL_MEM=80

# Modo do container (collector | dashboard | trainer)
RUN_MODE=collector

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text
