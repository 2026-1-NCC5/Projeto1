# Copie para .env e ajuste conforme seu ambiente.
# .env já está no .gitignore — nunca comite chaves reais.

# ===== Banco =====
# DATABASE_URL=sqlite:///bd/abraceai.db
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/abraceai

# ===== Visão computacional =====
# Caminho relativo ao backend/ ou absoluto.
# YOLO_MODEL_PATH=modelo-visao-computacional/v3_final.pt
YOLO_CONF_THRESHOLD=0.35

# ===== Gemini Flash =====
# Obter chave em https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite-preview

# ===== Gatilho por estabilidade =====
# Tempo (s) que o objeto precisa ficar parado antes de disparar análise.
STABILITY_SECONDS=1.5
# IoU mínimo entre frames para considerar a bbox "a mesma".
STABILITY_IOU_MIN=0.85
# Tempo (s) de lock após disparo para evitar duplicidade.
LOCK_SECONDS=3.0

# ===== Evidências =====
# EVIDENCIA_DIR=evidencias
